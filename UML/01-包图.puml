@startuml
!pragma layout elk
skinparam defaultFontName "Microsoft YaHei"
skinparam dpi 140
skinparam shadowing false
skinparam roundcorner 6
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.3
skinparam packageBorderColor #94A3B8
skinparam packageBackgroundColor #F8FAFC
skinparam componentBorderColor #94A3B8
skinparam componentBackgroundColor #FFFFFF
skinparam componentStyle rectangle
top to bottom direction

package "表现层" as PL {
  [买家工作台]
  [卖家工作台]
  [管理员工作台]
}

package "接口层" as API {
  [REST 接口]
  [鉴权过滤器]
  [统一异常与响应]
}

package "应用层" as APP {
  [用户应用服务]
  [商品应用服务]
  [检索应用服务]
  [预约应用服务]
  [举报应用服务]
  [日志应用服务]
  [统计应用服务]
}

package "领域层" as DOM {
  [领域实体]
  [预约唯一性服务]
  [商品状态机]
  [仓储接口]
}

package "基础设施层" as INF {
  [MySQL 仓储实现]
  [Redis 缓存]
  [对象存储]
  [站内通知]
}

PL --> API
API --> APP
APP --> DOM
APP --> INF
INF ..> DOM : 实现仓储接口

note right of APP
  应用服务负责用例编排与事务边界；
  跨模块调用只经过应用服务接口，
  表现层不直接访问仓储。
end note
@enduml
